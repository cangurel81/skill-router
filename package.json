{
  "name": "@cangurel81/skill-router",
  "version": "1.0.1",
  "description": "Index, classify and search a large agent-skill catalogue. Answers \"which skill fits this job?\" and reports catalogue bloat caused by duplicated locale trees.",
  "type": "module",
  "bin": {
    "skill-router": "bin/skill-router.mjs"
  },
  "files": [
    "bin/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "agent",
    "skills",
    "skill-router",
    "claude-code",
    "opencode",
    "codex",
    "ai-agents",
    "tooling",
    "cli"
  ],
  "license": "MIT",
  "author": "Can Gürel (https://webadhere.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cangurel81/skill-router.git"
  },
  "homepage": "https://github.com/cangurel81/skill-router#readme",
  "bugs": {
    "url": "https://github.com/cangurel81/skill-router/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node bin/skill-router.mjs",
    "test": "node --check bin/skill-router.mjs && node test/smoke.mjs"
  }
}
